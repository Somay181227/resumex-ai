PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resumex?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000
# Users registering with these emails become admins
ADMIN_EMAILS=admin@resumex.ai

# AI provider (optional). Set ONE of these; without a key a rule-based engine is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
